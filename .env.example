# ResumeFit AI settings. Copy to .env (never commit .env) and fill in the
# secrets. docker-compose.yml reads this file; see README.md for every variable.

# --- Public site (read by Caddy) ---
DOMAIN=resume.dineshlabs.in
# Contact address for the Let's Encrypt account; use an address you read.
ACME_EMAIL=admin@dineshlabs.in

# --- Secrets (leave nothing here in the example) ---
# Required. Without it the page shows only a configuration error.
OPENAI_API_KEY=
# Optional shared access code; empty keeps the site open.
APP_ACCESS_CODE=
# Keeps visitor keys stable across restarts; empty = random per start.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
VISITOR_HASH_SECRET=

# --- Model ---
OPENAI_MODEL=gpt-4o-mini

# --- Usage limits (owner-accepted defaults) ---
DAILY_ANALYSES_PER_VISITOR=5
CONCURRENT_ANALYSES_PER_VISITOR=1
GLOBAL_DAILY_ANALYSES=200
MAX_CONCURRENT_ANALYSES=3
ANALYSIS_TIMEOUT_SECONDS=180
MAX_AGENT_MESSAGES=20
MAX_TOTAL_TOKENS=150000
MAX_OUTPUT_TOKENS_PER_CALL=4000

# --- Wiring (docker-compose.yml sets these three for the app container
# whatever is written here; kept so the file lists every setting) ---
MCP_URL=http://mcp:8000/mcp
TRUST_PROXY_HEADERS=true
CLIENT_IP_HEADER=X-Real-IP

LOG_LEVEL=INFO
